# syntax=docker/dockerfile:1
# Licensed under the Apache License, Version 2.0. See LICENSE and NOTICE.
ARG PROXY_IMAGE=missing:missing
FROM ${PROXY_IMAGE} AS proxy
FROM docker.io/apache/openserverless-runtime-java@sha256:19682a175bf6e53816d8b6d203b48dedf63e02a63967be946db7009f51fe2cb0 AS contract
FROM docker.io/library/ibm-semeru-runtimes@sha256:03bdcd7e42b1b4afa57d246e50f8d74c4a93fe9e881d23237131b99e44736976
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends python3 python-is-python3 locales zip unzip \
    && locale-gen en_US.UTF-8 && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /javaAction/action /usr/share/ops-security/proxy
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8 \
    VERSION=8 UPDATE=512 BUILD=09 OW_LOG_INIT_ERROR=1 \
    OW_COMPILER=/bin/compile OW_SAVE_JAR=exec.jar
WORKDIR /javaAction
COPY --from=contract /usr/java/ /usr/java/
COPY tools/runtime-security/java-compile.py /bin/compile
COPY tools/runtime-security/Launcher.java /usr/java/src/Launcher.java
RUN chmod 755 /bin/compile && cd /usr/java/src && rm -f ./*.class \
    && javac -cp /usr/java/lib/gson-2.11.0.jar Launcher.java \
    && jar cf /usr/java/lib/launcher.jar ./*.class
COPY --from=contract /LICENSE /NOTICE /DISCLAIMER /
COPY --from=proxy /out/proxy /bin/proxy
COPY --from=proxy /out/proxy-build.txt /out/proxy-tests.json /out/SOURCE /usr/share/ops-security/proxy/
ENTRYPOINT ["/bin/proxy"]
