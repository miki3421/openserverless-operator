# Keep the qualified ADV operator byte-for-byte except for the database
# controller selection. The base already contains the FerretDB controller and
# deployment assets; this layer restores it as the default implementation.
FROM docker.io/miki3421/ops-advanced-operator@sha256:50563fce3d60a5ed338d0db99de7042cc893380840b685493c749486ec30ec93

COPY --chown=1001:1001 openserverless/main.py /home/openserverless/openserverless/main.py
COPY --chown=1001:1001 openserverless/templates/ferretdb-sts.yaml /home/openserverless/openserverless/templates/ferretdb-sts.yaml
COPY --chown=1001:1001 deploy/ferretdb/ferretdb-sts.yaml /home/openserverless/deploy/ferretdb/ferretdb-sts.yaml
